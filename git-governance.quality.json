{
  "schemaVersion": 4,
  "toolchain": { "language": "go", "version": "1.26.6" },
  "extends": [],
  "gates": [
    {
      "name": "platform-source-quality",
      "command": "go",
      "args": [
        "tool",
        "-modfile",
        "tools/go.mod",
        "quality-gate"
      ],
      "timeout": "15m"
    }
  ],
  "project": {
    "binaries": [
      {
        "package": "./cmd/broker",
        "smoke": ["--version"]
      }
    ],
    "fuzz": [
      {
        "package": "./internal/config",
        "target": "FuzzParseRepository",
        "time": "50000x"
      },
      {
        "package": "./internal/broker",
        "target": "FuzzTokenRequestBoundary",
        "time": "50000x"
      }
    ]
  }
}
